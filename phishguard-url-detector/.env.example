# Flask Environment
FLASK_ENV=development
FLASK_APP=app.py

# Cryptographic Secret Key for sessions and CSRF
SECRET_KEY=change-this-to-a-secure-random-string-in-production

# Custom Database Location (default: ./phishguard.db)
# DATABASE_PATH=/custom/path/to/phishguard.db

# Custom Model Location (default: ./model/phishguard_model.joblib)
# MODEL_PATH=/custom/path/to/phishguard_model.joblib

# Input validation limits
MAX_URL_LENGTH=2048
